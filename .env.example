# Copy to `.env` (git-ignored) and fill in. Never paste keys into chat or commit them.

# Crustdata (People Search / Job Postings / Company Enrichment). Required for LIVE data.
CRUSTDATA_API_KEY=

# Anthropic (Brief Interpreter, Sourcer, Fit rubric, Critic, Outreach, Failure Analyst).
# Not needed if you have run `ant auth login`; required otherwise for real LLM runs.
ANTHROPIC_API_KEY=

# Optional: force a backend. auto = live/anthropic when a key is present, else sim/mock.
TTR_CRUST_BACKEND=auto
TTR_LLM_BACKEND=auto

# Optional: approved-send allowlist (comma separated). Sends are DISABLED by default and
# only ever go to these team addresses during the event.
TTR_SEND_ALLOWLIST=
# Optional SMTP for the approve-send demo (otherwise sends are written to outbox/sent/).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fault injection for the robustness suite (leave empty in normal runs).
# e.g. FAULT_INJECT=429:0.33,5xx:0.2,empty:0.0,llm_json:0.25
FAULT_INJECT=
FAULT_SEED=13
